# Vercel detects this file and runs it as an HTTP container. The release image
# comes from Micelio's published multi-architecture container image.
FROM ghcr.io/tuist/micelio:latest

ENV MICELIO_AUTH_BACKEND=static

# Vercel assigns PORT at runtime. Micelio otherwise defaults to 4000, which is
# right for Docker, Kubernetes, Render, and DigitalOcean App Platform.
CMD ["/bin/sh", "-c", "MICELIO_GIT_PORT=\"${PORT:-4000}\" exec /app/bin/micelio start"]
