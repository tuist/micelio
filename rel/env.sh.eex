#!/bin/sh
# Release environment.
#
# Each node needs a distinct name for distributed Erlang. In Kubernetes the pod
# IP is the only thing guaranteed unique and routable, so it is used directly:
# a stable hostname would need a StatefulSet, and the whole point is that this
# is a Deployment.

if [ -n "$MICELIO_POD_IP" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${MICELIO_RELEASE_NAME:-micelio}@${MICELIO_POD_IP}"
  export MICELIO_NODE_ID="${MICELIO_NODE_ID:-$MICELIO_POD_IP}"
elif [ -n "$MICELIO_NODE_NAME" ]; then
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="$MICELIO_NODE_NAME"
else
  # No clustering configured. A single node is fully durable on its own,
  # because the log lives in object storage.
  export RELEASE_DISTRIBUTION=none
fi
