#!/bin/sh
# Release environment.
#
# The BEAM sizes its port table from the process file-descriptor limit, and
# pre-allocates it at boot. Container runtimes hand out enormous defaults —
# containerd gives 1073741816, which makes the BEAM reserve a table for 134
# million ports and idle at 2.1 GB instead of 200 MB. It then dies against any
# sensible memory limit, having logged nothing.
#
# The ceiling that matters here is concurrent Git streams and HTTP connections,
# which is thousands, not millions. Override MICELIO_MAX_PORTS if a deployment
# genuinely needs more.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-${MICELIO_MAX_PORTS:-65536}}"

#
# Distributed Erlang needs each node to have a unique, routable name. The
# address a container was given is the only thing guaranteed to be both, so it
# is used directly: anything stabler would need a StatefulSet, and the whole
# point of this design is that a node holds nothing worth stabilising.

if [ -n "${MICELIO_NODE_NAME:-}" ]; then
  # Explicit wins, for anyone who knows better.
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="$MICELIO_NODE_NAME"
elif [ -n "${MICELIO_POD_IP:-}" ]; then
  # Kubernetes, via the downward API.
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${MICELIO_RELEASE_NAME:-micelio}@${MICELIO_POD_IP}"
  export MICELIO_NODE_ID="${MICELIO_NODE_ID:-$MICELIO_POD_IP}"
elif [ "${MICELIO_CLUSTER_STRATEGY:-none}" != "none" ]; then
  # Anywhere else that wants clustering — Docker Compose, a bare host — work
  # the address out rather than making the operator inject it.
  ip=$(hostname -i 2>/dev/null | awk '{print $1}')
  if [ -z "$ip" ]; then
    ip=$(getent hosts "$(hostname)" 2>/dev/null | awk '{print $1; exit}')
  fi

  if [ -n "$ip" ]; then
    export RELEASE_DISTRIBUTION=name
    export RELEASE_NODE="${MICELIO_RELEASE_NAME:-micelio}@${ip}"
    export MICELIO_NODE_ID="${MICELIO_NODE_ID:-$ip}"
  else
    echo "micelio: clustering requested but this container's address could not be determined" >&2
    export RELEASE_DISTRIBUTION=none
  fi
else
  # No clustering. A single node is fully durable on its own, because the log
  # lives in object storage.
  export RELEASE_DISTRIBUTION=none
fi
